# Variables de entorno de ejemplo para DocFlow Pro (100% Cloudflare Nativo)
# Copiar a .dev.vars para desarrollo local con Wrangler, o configurar como secrets/vars en Cloudflare Workers.

# Cloudflare Account & Deploy (solo para CLI / scripts / CI)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare Turnstile (Widget anti-bot en Login / Registro / Recuperación)
TURNSTILE_SITE_KEY=

# Opcional: Origen de exportación Firestore JSON o REST para script de migración única
FIREBASE_EXPORT_JSON=